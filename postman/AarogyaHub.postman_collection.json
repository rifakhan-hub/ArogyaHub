    {
      "name": "02 List users",
      "description": "GET /admin/users with search, filters, sorting and paging. Run scripts.seed_users first.",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"has a page of users\", () => {",
                  "    pm.expect(body).to.have.keys(\"items\", \"total\", \"page\", \"page_size\");",
                  "    pm.expect(body.items.length).to.be.above(0);",
                  "    pm.expect(body.page).to.eql(1);",
                  "    pm.expect(body.page_size).to.eql(20);",
                  "});",
                  "pm.test(\"each user has the fields the admin panel needs\", () => {",
                  "    pm.expect(body.items[0]).to.include.keys(\"id\", \"name\", \"email\", \"phone\", \"city\", \"role\", \"is_active\", \"blocked_reason\", \"created_at\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "New user appears in the list",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/users?q={{newEmail}}",
