                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"returns a token and the user\", () => {",
                  "    pm.expect(body.token_type).to.eql(\"bearer\");",
                  "    pm.expect(body.access_token).to.be.a(\"string\");",
                  "    pm.expect(body.user.email).to.eql(pm.collectionVariables.get(\"newEmail\"));",
                  "});",
                  "pm.test(\"sets the refresh cookie\", () => pm.expect(pm.cookies.has(\"refresh_token\")).to.be.true);",
                  "pm.collectionVariables.set(\"accessToken\", body.access_token);"
                ]
              }
            }
          ]
