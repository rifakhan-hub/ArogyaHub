{
  "info": {
    "_postman_id": "7a985c13-f304-4326-b493-408f1622b875",
    "name": "AarogyaHub API",
    "description": "Auth and users API for AarogyaHub.\n\n1. Start the backend from the backend folder: `.venv/Scripts/python -m uvicorn app.main:app --reload --port 8000`\n2. Load the sample users once: `.venv/Scripts/python -m scripts.seed_users`\n3. Create your admin once: `.venv/Scripts/python -m scripts.create_admin`\n4. In the 'AarogyaHub local' environment, set adminEmail and adminPassword to that admin.\n5. Run the collection in order.\n\nRequests send the saved access token automatically (collection Authorization: Bearer {{accessToken}}).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 Health",
      "description": "Is the API up and can it reach MySQL?",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"database is reachable\", () => pm.expect(pm.response.json().db).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Auth",
      "description": "Register, log in, refresh. Each run registers a new patient with a fresh email.",
      "item": [
        {
          "name": "Register a new patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Patient\",\n  \"email\": \"{{newEmail}}\",\n  \"phone\": null,\n  \"city\": \"Ludhiana\",\n  \"role\": \"patient\",\n  \"password\": \"postman-pass-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"newEmail\", `postman.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const user = pm.response.json();",
                  "pm.test(\"account saved with the details sent\", () => {",
                  "    pm.expect(user.email).to.eql(pm.collectionVariables.get(\"newEmail\"));",
                  "    pm.expect(user.name).to.eql(\"Postman Patient\");",
                  "    pm.expect(user.role).to.eql(\"patient\");",
                  "});",
                  "pm.test(\"password is never sent back\", () => pm.expect(pm.response.text()).to.not.include(\"password\"));",
                  "pm.collectionVariables.set(\"newUserId\", user.id);"
                ]
              }
            }
          ]
        },
